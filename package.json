{
  "name": "abaco",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de estudio para carreras económicas y administrativas: materias por carrera y ciclo, tema por tema, fórmulas verificadas, herramientas de estudio y buscador académico. Sin registro y sin servidores.",
  "license": "MIT",
  "author": "Diego Francisco Granda Zhingre",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "vitest run tests/content",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "generate": "node scripts/build-search-index.ts && node scripts/build-math.ts && node scripts/build-licenses.ts",
    "icons": "node scripts/build-icons.ts",
    "screenshots": "node scripts/screenshots.ts",
    "pdf:analizar": "node scripts/pdf-analizar.ts",
    "cobertura": "node scripts/cobertura.ts && prettier --write docs/cobertura.md",
    "ficha": "vitest run tests/content/ficha.test.ts --silent=false",
    "fuentes:verificar": "node scripts/verificar-fuentes.ts",
    "cobertura:estado": "node scripts/estado-cobertura.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@formulajs/formulajs": "4.6.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "katex": "0.19.0",
    "minisearch": "7.2.0",
    "motion": "14.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "workbox-window": "7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-build": "7.4.1"
  }
}
